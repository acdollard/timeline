---
import Layout from "../layouts/Layout.astro";

const { request } = Astro;

const url = new URL(request.url);
const error = url.searchParams.get("error");

// Auth tokens arrive in the URL hash (never sent to the server) or as legacy
// query params. Both paths are handled by the client script below via
// /api/auth/session-from-tokens — do not reintroduce SSR token reads here.

// Helper function to get error message
const getErrorMessage = (error: string | null) => {
  switch (error) {
    case "invalid_confirmation_link":
      return "Invalid or expired confirmation link. Please request a new confirmation email.";
    case "session_error":
      return "Failed to confirm your email. Please try again or contact support.";
    default:
      return "An error occurred while confirming your email. Please try again.";
  }
};
---

<Layout title="Confirm Email">
  <div
    class="flex flex-col items-center justify-center h-screen bg-darkestGray"
  >
    <div
      class="bg-gray-800 rounded-lg flex flex-col items-center justify-center gap-4 w-full max-w-md p-8 text-white"
    >
      <h1 class="text-2xl font-bold">Confirming Your Email</h1>

      <div
        id="confirm-status"
        class="w-full p-3 bg-blue-500/10 border border-blue-500/20 rounded-md"
      >
        <p id="confirm-status-text" class="text-sm text-blue-400">
          {error
            ? getErrorMessage(error)
            : "Processing your email confirmation..."}
        </p>
      </div>

      <p id="confirm-help" class="text-sm text-gray-400 text-center">
        Please wait while we confirm your email address.
      </p>

      <a
        id="confirm-cta"
        href={error ? "/signin" : "/"}
        class="w-full bg-primary text-white px-4 py-2 rounded-md hover:bg-primary/90 transition-colors text-center hidden"
      >
        {error ? "Back to Sign In" : "Go to Timeline"}
      </a>
    </div>
  </div>

  <script>
    const statusBox = document.getElementById("confirm-status");
    const statusText = document.getElementById("confirm-status-text");
    const helpText = document.getElementById("confirm-help");
    const cta = document.getElementById("confirm-cta");
    const params = new URLSearchParams(window.location.search);
    const preexistingError = params.get("error");

    function setStatus(
      kind: "info" | "success" | "error",
      message: string,
      ctaLabel?: string,
      ctaHref?: string
    ) {
      if (statusBox && statusText) {
        statusBox.className =
          kind === "success"
            ? "w-full p-3 bg-green-500/10 border border-green-500/20 rounded-md"
            : kind === "error"
              ? "w-full p-3 bg-red-500/10 border border-red-500/20 rounded-md"
              : "w-full p-3 bg-blue-500/10 border border-blue-500/20 rounded-md";
        statusText.className =
          kind === "success"
            ? "text-sm text-green-400"
            : kind === "error"
              ? "text-sm text-red-400"
              : "text-sm text-blue-400";
        statusText.textContent = message;
      }
      if (helpText) {
        helpText.textContent =
          kind === "success"
            ? "Your email has been confirmed and you're now signed in."
            : kind === "error"
              ? "You can return to sign in and request a new confirmation email if needed."
              : "Please wait while we confirm your email address.";
      }
      if (cta instanceof HTMLAnchorElement && ctaLabel && ctaHref) {
        cta.textContent = ctaLabel;
        cta.href = ctaHref;
        cta.classList.remove("hidden");
      }
    }

    function stripSensitiveParams() {
      const clean = new URL(window.location.href);
      clean.searchParams.delete("access_token");
      clean.searchParams.delete("refresh_token");
      clean.hash = "";
      const search = clean.searchParams.toString();
      history.replaceState(
        null,
        "",
        clean.pathname + (search ? `?${search}` : "")
      );
    }

    async function establishSession(accessToken: string, refreshToken: string) {
      const response = await fetch("/api/auth/session-from-tokens", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          access_token: accessToken,
          refresh_token: refreshToken,
        }),
      });

      if (!response.ok) {
        throw new Error("Failed to confirm email");
      }
    }

    async function confirmFromTokens(accessToken: string, refreshToken: string) {
      stripSensitiveParams();
      await establishSession(accessToken, refreshToken);
      setStatus(
        "success",
        "Email confirmed successfully! Redirecting to your timeline...",
        "Go to Timeline",
        "/"
      );
      setTimeout(() => {
        window.location.href = "/";
      }, 2000);
    }

    if (preexistingError) {
      setStatus(
        "error",
        preexistingError === "invalid_confirmation_link"
          ? "Invalid or expired confirmation link. Please request a new confirmation email."
          : "An error occurred while confirming your email. Please try again.",
        "Back to Sign In",
        "/signin"
      );
    } else {
      const hash = window.location.hash.startsWith("#")
        ? window.location.hash.slice(1)
        : window.location.hash;
      const hashParams = new URLSearchParams(hash);
      const hashAccess = hashParams.get("access_token");
      const hashRefresh = hashParams.get("refresh_token");
      const type = hashParams.get("type");

      if (hashAccess && hashRefresh) {
        if (type === "recovery") {
          // Keep tokens in the hash when routing to reset-password.
          window.location.replace(`/reset-password${window.location.hash}`);
        } else {
          confirmFromTokens(hashAccess, hashRefresh).catch(() => {
            setStatus(
              "error",
              "Failed to confirm your email. Please try again or contact support.",
              "Back to Sign In",
              "/signin"
            );
          });
        }
      } else {
        const queryAccess = params.get("access_token");
        const queryRefresh = params.get("refresh_token");
        if (queryAccess && queryRefresh) {
          confirmFromTokens(queryAccess, queryRefresh).catch(() => {
            setStatus(
              "error",
              "Failed to confirm your email. Please try again or contact support.",
              "Back to Sign In",
              "/signin"
            );
          });
        } else {
          window.location.replace("/signin?error=invalid_confirmation_link");
        }
      }
    }
  </script>
</Layout>
