---
import Layout from "../layouts/Layout.astro";
import { clearAuthSessionCookies, getAuthenticatedRequest } from "../lib/supabase";

const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

if (!accessToken || !refreshToken) {
  return Astro.redirect("/signin");
}

let session;
try {
  const auth = await getAuthenticatedRequest(Astro.cookies);
  session = auth.session;
  if (!session) {
    clearAuthSessionCookies(Astro.cookies);
    return Astro.redirect("/signin");
  }
} catch (error) {
  clearAuthSessionCookies(Astro.cookies);
  return Astro.redirect("/signin");
}

const email = session.user?.email;
---

<Layout title="dashboard">
  <div
    class="flex flex-col items-center justify-center max-w-7xl mx-auto text-white"
  >
    <h1 class="text-2xl font-bold">Welcome {email}</h1>
    <p class="text-sm text-gray-400">We are happy to see you here</p>
    <form action="/api/auth/signout">
      <button type="submit">Sign out</button>
    </form>
  </div>
</Layout>
