---
import "../styles/global.css";
import Navbar from "../components/Navbar";
import BackButton from "../components/BackButton";
import { getAuthenticatedRequest } from "../lib/supabase";

interface Props {
  title?: string;
  requireAuth?: boolean;
  showBackButton?: boolean;
}

const {
  title = "Timeline",
  requireAuth = false,
  showBackButton = true,
} = Astro.props;

const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");
const currentPath = Astro.url.pathname;

let session = null;
if (accessToken && refreshToken) {
  try {
    const auth = await getAuthenticatedRequest(Astro.cookies);
    session = auth.session;
  } catch (error) {
    // Session is already null, no need to handle error
  }
}

if (requireAuth && !session) {
  return Astro.redirect("/signin");
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-gray-900 min-h-screen">
    <Navbar client:load initialSession={session} currentPath={currentPath} />
    {showBackButton && <BackButton client:load />}
    <main>
      <slot />
    </main>
  </body>
</html>
